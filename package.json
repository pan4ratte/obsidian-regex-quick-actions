{
  "name": "regex-quick-actions",
  "version": "2.1.0",
  "description": "Create and quickly apply regex commands via command palette, context menus and hotkeys. Made for automation purposes.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "tsc -noEmit -skipLibCheck && rollup -c",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"**/*.css\" --ignore-disables",
    "fix": "eslint . --fix && stylelint \"**/*.css\" --fix"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^8.0.0",
    "@types/node": "^14.14.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^16.5.0",
    "rollup": "^2.32.1",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "^2.0.3",
    "typescript": "^4.0.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "obsidian": "1.13.1"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
